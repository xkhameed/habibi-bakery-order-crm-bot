# Nusxa oling: cp .env.example .env  va qiymatlarni to'ldiring
BOT_TOKEN=123456:ABC-sizning-tokeningiz
BOT_USERNAME=HabibiBakeryBot
# Admin (yoki adminlar guruhi) chat ID si. Botga /admin_id yozib bilib olasiz
ADMIN_CHAT_ID=0
# Mini App manzili (faqat https). Lokal sinov uchun: cloudflared tunnel --url http://localhost:8080
WEB_APP_URL=https://example.trycloudflare.com
CARD_NUMBER=8600 0000 0000 0000
CARD_HOLDER=Ism Familiya
SHOP_PHONE=+998 90 000 00 00
DB_URL=jdbc:postgresql://localhost:5432/habibi_bakery
DB_USER=postgres
DB_PASSWORD=
# Brauzerda Telegram'siz sinash uchun true qiling (serverda doim false!)
DEV_MODE=false
